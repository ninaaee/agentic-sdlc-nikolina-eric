@startuml c4-component-bank-ocr

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Bank OCR CLI - Component View

AddRelTag("orchestration", $lineColor="#1168BD", $textColor="#1168BD")
AddRelTag("dependency", $lineColor="#B8860B", $textColor="#B8860B", $lineStyle="Dashed()")

Container_Boundary(cli, "Bank OCR CLI") {
  Component(orchestrator, "CLI Orchestrator", "Entry point that wires and drives the five modules (no domain logic)")
  Component(parser, "Input Parser", "Reads the input file and splits it into account records")
  Component(recognizer, "Digit Recognizer", "Maps each 3x3 glyph to a digit, or ? if no match")
  Component(validator, "Account Validator", "Applies the mod-11 checksum and classifies the record")
  Component(corrector, "Error Corrector", "Repairs ERR/ILL records by single-segment changes")
  Component(reporter, "Report Generator", "Formats the final result line per record")
}

Rel(orchestrator, parser, "reads and splits records", $tags="orchestration")
Rel(orchestrator, recognizer, "recognizes digits", $tags="orchestration")
Rel(orchestrator, validator, "validates and classifies", $tags="orchestration")
Rel(orchestrator, corrector, "corrects ERR/ILL records", $tags="orchestration")
Rel(orchestrator, reporter, "writes result lines", $tags="orchestration")

Rel(corrector, recognizer, "re-recognize modified glyph", $tags="dependency")
Rel(corrector, validator, "validate candidate checksum", $tags="dependency")

SHOW_LEGEND()

@enduml
